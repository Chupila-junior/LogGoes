# Copie este arquivo para ".env" e preencha. O ".env" NUNCA deve ir para o Git.

# --- Fleetbase (API pública, rodando localmente no Docker) ---
FLEETBASE_API_URL=http://localhost:8000/v1
# Chave secreta gerada em: console do Fleetbase > Developers > API Keys
FLEETBASE_API_KEY=cole_a_chave_secreta_aqui

# --- Microsoft Foundry ---
# Copie pelo ícone de copiar na página inicial do projeto no portal (ai.azure.com)
FOUNDRY_PROJECT_ENDPOINT=https://SEU-RECURSO.services.ai.azure.com/api/projects/SEU-PROJETO
# Nome do deployment do modelo (pode ser diferente do nome do modelo)
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
